# ════════════════════════════════════════════════════════
#  就活メモ整理AIエージェント 環境変数設定
#
#  このファイルをコピーして .env を作成してください:
#    cp .env.example .env
#
#  ★ 必須項目は2つだけです ★
# ════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────
# [必須] Google Gemini API キー
#   取得場所: https://aistudio.google.com/app/apikey
#   形式: AIza で始まる文字列
# ──────────────────────────────────────────────────────────
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ──────────────────────────────────────────────────────────
# [必須] Google スプレッドシート ID
#   取得方法: スプレッドシートのURLから
#     https://docs.google.com/spreadsheets/d/【ここ】/edit
# ──────────────────────────────────────────────────────────
GOOGLE_SPREADSHEET_ID=1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ──────────────────────────────────────────────────────────
# [任意] Google サービスアカウント認証情報
#   2通りの指定方法があり、環境変数に JSON の中身があればそちらを優先します。
#
#   (A) ローカル開発: 鍵 JSON ファイルのパスを指定（デフォルト動作）
#       デフォルト: ./service_account.json（ルートに置く場合は変更不要）
#   (B) Render 等のデプロイ環境: 鍵 JSON の「中身そのもの」を1行で指定
#       （ファイルを置けない環境向け）
#       GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}
# ──────────────────────────────────────────────────────────
# GOOGLE_SERVICE_ACCOUNT_JSON=./service_account.json

# ──────────────────────────────────────────────────────────
# [任意] 使用する Gemini モデル名
#   デフォルト: gemini-3.6-flash（config.py の既定値）
#   常に最新を追う場合: gemini-flash-latest（バージョンは自動で変わる）
#   注意: gemini-1.5-flash / gemini-2.5-flash は新規ユーザー提供終了
# ──────────────────────────────────────────────────────────
# GEMINI_MODEL=gemini-3.6-flash

# ──────────────────────────────────────────────────────────
# [任意] スプレッドシート読み取りのキャッシュ有効期間（秒）
#   デフォルト: 60。小さくすると最新反映が速いが API 呼び出しが増える。
# ──────────────────────────────────────────────────────────
# CACHE_TTL_SECONDS=60
